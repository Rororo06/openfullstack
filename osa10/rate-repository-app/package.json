    "dotenv": "^17.4.2",
    "expo": "^57.0.18",
    "expo-constants": "^57.0.16",
    "expo-linking": "^57.0.8",
    "formik": "^2.4.9",
    "graphql": "^16.14.2",
    "react": "^19.2.8",
